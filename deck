#!/bin/zsh
# deck — tmux セッションでエージェント CLI を起動する（Agent Deck）
#
# 使い方:
#   deck <ディレクトリ> [CLIへの追加引数...]
#   deck ~/projects/my-app
#   deck ~/projects/my-app --resume
#
# 起動する CLI は TAB_BIN で差し替えられる（既定は claude）。

set -eu

DIR="${1:-$HOME}"
shift 2>/dev/null || true

DIR="${DIR/#\~/$HOME}"   # チルダ展開（ssh経由でクォートされた場合対策）

if [[ ! -d "$DIR" ]]; then
  echo "エラー: ディレクトリが存在しません: $DIR" >&2
  exit 1
fi

# tmux の場所は PATH → 標準的なインストール先の順で解決する
find_bin() {
  command -v "$1" 2>/dev/null && return
  for p in /opt/homebrew/bin /usr/local/bin /usr/bin; do
    [[ -x "$p/$1" ]] && { echo "$p/$1"; return; }
  done
  echo "$1"
}
TMUX="${TMUX_BIN:-$(find_bin tmux)}"

# 起動するCLI（TAB_BIN で差し替え可能。パス名でなければ PATH 等から解決する）
BIN="${TAB_BIN:-claude}"
if [[ "$BIN" != */* ]]; then
  BIN="$(command -v "$BIN" 2>/dev/null || echo "$HOME/.local/bin/$BIN")"
fi

# Claudeの標準TUIはalternate screenを使うためtmux履歴が残らない。
# Web操作用セッションではフラット表示にしてスクロールバックへ出力する。
if [[ "${BIN:t}" == "claude" ]]; then
  HAS_AX_SCREEN_READER=0
  for arg in "$@"; do
    [[ "$arg" == "--ax-screen-reader" ]] && HAS_AX_SCREEN_READER=1
  done
  if [[ "$HAS_AX_SCREEN_READER" == "0" ]]; then
    set -- --ax-screen-reader "$@"
  fi
fi

# 残りの引数（--model やプロンプト文字列）を安全にクォートして連結する
ARGS=""
if (( $# > 0 )); then
  ARGS=" ${(j: :)${(@q)@}}"
fi

# Web UI からも操作できるよう、エージェントを tmux 内で起動する。
SESSION="agent-$(date +%Y%m%d-%H%M%S)-$$"

# CLAUDE_TAB_LABEL: 自動起動セッションの識別札。同じ札の古いセッションを起動前に片付ける。
# launchd から毎日呼ばれるジョブが、前日分を残したまま積み上がるのを防ぐ。
LABEL="${CLAUDE_TAB_LABEL:-}"
if [[ -n "$LABEL" ]]; then
  for s in $("$TMUX" list-sessions -F '#{session_name}' 2>/dev/null); do
    if [[ "$("$TMUX" show-option -qv -t "$s" @launcher_label 2>/dev/null)" == "$LABEL" ]]; then
      "$TMUX" kill-session -t "$s" 2>/dev/null || true
    fi
  done
fi

# CLAUDE_TAB_EPHEMERAL=1: エージェント終了と同時に tmux セッションごと消える（自動起動用）。
# 通常セッションは終了後もシェルを残し、出力を読み返せるようにする。
if [[ "${CLAUDE_TAB_EPHEMERAL:-0}" == "1" ]]; then
  CMD="${BIN}${ARGS}"
else
  CMD="${BIN}${ARGS}; printf '\n[セッションが終了しました]\n'; exec /bin/zsh -l"
fi

# CLAUDE_TAB_SESSION をセッション環境に入れ、エージェント自身が終了時に kill-session できるようにする。
"$TMUX" new-session -d -s "$SESSION" -c "$DIR" -e "CLAUDE_TAB_SESSION=$SESSION" -e "DECK_SESSION=$SESSION" -- /bin/zsh -lic "$CMD"
"$TMUX" set-option -g history-limit 10000
"$TMUX" set-option -g focus-events on
"$TMUX" set-option -t "$SESSION" @launcher_tool "${BIN:t}"
if [[ -n "$LABEL" ]]; then
  "$TMUX" set-option -t "$SESSION" @launcher_label "$LABEL"
fi
if [[ "${CLAUDE_TAB_EPHEMERAL:-0}" != "1" ]]; then
  # remain-on-exit は死んだペインを残すため、消えてほしい自動起動セッションでは付けない。
  "$TMUX" set-option -t "$SESSION" remain-on-exit on
fi

echo "OK: ${DIR} で ${BIN:t} を起動しました (session ${SESSION})"
